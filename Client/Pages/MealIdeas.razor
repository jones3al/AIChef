@page "/mealideas"
@using AIChef.Shared;
@using AIChef.Client.Shared;
@using System.Text.Json;
@inject NavigationManager navigationManager;
@inject HttpClient Http;

@if (isLoaded == true)
{
    <div class="container">
        @if (ideas.Count > 0)
        {
            <h3 class="mt-5">Pick a meal to make</h3>

            <div class="list-group">
                @foreach (var idea in ideas)
                {
                    <button @onclick="() => GetRecipe(idea.Index)" class="list-group-item list-group-item-action list-group-item-success p-2">
                        <div class="d-flex w-100 justify-content-sm-between">
                            <h2 class="mb-1 fw-bold">@idea.Title</h2>
                        </div>
                         <p class="mb-1">@idea.Description</p>

                    </button>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning mt-5" role="alert">
                <h4 class="alert-heading">No recipe ideas came back</h4>
                <p class="mb-0">@errorMessage</p>
            </div>
            <button class="btn btn-success rounded" @onclick="Retry">Try Again</button>
        }
    </div>
}
else
{
  <ChefSpinner></ChefSpinner>

}


@code {
    private List<Idea> ideas = new List<Idea>();
    private bool isLoaded = false;
    private string errorMessage = "";


    [CascadingParameter]
    private RecipeState? rState { get; set; }

    private readonly JsonSerializerOptions _jsonOptions = new JsonSerializerOptions()
        {
            PropertyNameCaseInsensitive = true,
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
            DefaultIgnoreCondition = System.Text.Json.Serialization.JsonIgnoreCondition.WhenWritingNull
        };

    protected override async Task OnInitializedAsync()
    {
        if (rState is null)
        {
            navigationManager.NavigateTo("/", forceLoad: true);
            return;
        }

        if (rState.Ideas.Count<1)
        {
            await GetIdeas();
        }
        else
        {
            isLoaded = true;
            ideas = rState.Ideas;
        }

    }

    private async Task Retry()
    {
        await GetIdeas();
    }

    // Returns a Task rather than void so failures are observable and the caller can await it.
    // As async void, an exception here left isLoaded false and the spinner up forever.
    private async Task GetIdeas()
    {
        string baseuri = "Recipe/GetRecipeIdeas";
        isLoaded = false;
        errorMessage = "";

        RecipeParms recipeParms = new RecipeParms()
            {
                MealTime = rState!.MealTime,
                Ingredients = rState.Ingredients
            };

        //call web api controller
        try
        {
            HttpResponseMessage response = await Http.PostAsJsonAsync(baseuri, recipeParms, _jsonOptions);

            response.EnsureSuccessStatusCode();

            ideas = (await response.Content.ReadFromJsonAsync<List<Idea>>()) ?? new List<Idea>();
            rState.Ideas = ideas;

            if (ideas.Count < 1)
            {
                errorMessage = "The recipe service returned no ideas. Check the server logs for the error reported by OpenAI.";
            }
        }
        catch (Exception ex)
        {
            ideas = new List<Idea>();
            errorMessage = $"Could not reach the recipe service: {ex.Message}";
            Console.WriteLine($"Error! Could not fetch recipe ideas: {ex}");
        }
        finally
        {
            // Always clears the spinner, so a failure surfaces instead of hanging.
            isLoaded = true;
        }
    }

    private void GetRecipe(int index)
    {
        navigationManager.NavigateTo($"/mealrecipe/{index}");
    }
}
